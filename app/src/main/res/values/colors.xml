    <color name="background_light">#FAFAFA</color>

    <color name="sky_top">#87CEEB</color>
    <color name="sky_bottom">#E0F6FF</color>
    <color name="forest_green">#2E7D32</color>
    <color name="wood_brown">#8D6E63</color>
    <color name="hill_green">#6B8E23</color>
    <color name="sun_yellow">#FFD966</color>

