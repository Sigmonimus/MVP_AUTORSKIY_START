<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Основные цвета -->
    <color name="black">#FF000000</color>
    <color name="white">#FFFFFFFF</color>

    <!-- Текст -->
    <color name="primary_text">#4A2E1A</color>        <!-- тёмно-коричневый для основного текста -->
    <color name="secondary_text">#8B7355</color>      <!-- светло-коричневый для второстепенного текста -->

    <!-- Акцентные цвета -->
    <color name="primary">#A67C27</color>              <!-- золотисто-коричневый (основной) -->
    <color name="primary_dark">#8B5A2B</color>         <!-- тёмный оттенок для акцентов -->
    <color name="primary_light">#E8DFD1</color>        <!-- светлый бежевый для фона карточек и обводки -->

    <!-- Цвета для кнопок и элементов управления -->
    <color name="button_background">#A67C00</color>    <!-- тёмно-золотой для кнопок -->

    <!-- Фоны -->
    <color name="window_background">#F5F2EB</color>    <!-- основной фон экранов -->
    <color name="card_background">#FFF7ED</color>      <!-- фон для карточек и аватарок -->
    <color name="avatar_background">#B37C15</color>    <!-- фон для аватарок (если используется как подложка) -->

    <!-- Специальные блоки (цитаты, предупреждения) -->
    <color name="quote_background">#E8DFD1</color>     <!-- бежевый для цитат -->
