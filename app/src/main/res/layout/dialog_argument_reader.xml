<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/reading_background">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp">

        <!-- Декоративная линия -->
        <View
            android:layout_width="48dp"
            android:layout_height="3dp"
            android:background="@color/reading_accent"
            android:layout_marginBottom="16dp" />

        <!-- Заголовок -->
        <TextView
            android:id="@+id/tvArgumentTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/reading_title"
            android:lineSpacingMultiplier="1.2"
            android:layout_marginBottom="8dp" />

        <!-- Подзаголовок -->
        <TextView
            android:id="@+id/tvWorkAuthor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="serif"
            android:textSize="15sp"
            android:textColor="@color/reading_subtitle"
            android:textStyle="italic"
            android:layout_marginBottom="24dp" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/reading_divider"
            android:layout_marginBottom="24dp" />

        <!-- Буквица + Текст -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <TextView
                android:id="@+id/tvDropCap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:textSize="72sp"
                android:textStyle="bold"
                android:textColor="@color/reading_dropcap"
                android:lineHeight="80sp"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:gravity="top" />

            <TextView
                android:id="@+id/tvArgumentContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="serif"
                android:textSize="18sp"
                android:textColor="@color/reading_text"
                android:lineSpacingMultiplier="1.5"
                android:hyphenationFrequency="full"
                android:breakStrategy="balanced"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <!-- Панель управления шрифтом -->
        <!-- Панель управления размером шрифта -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:orientation="horizontal"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_reader_controls"
            android:padding="8dp">

            <ImageButton
                android:id="@+id/btnDecreaseText"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_text_decrease"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Уменьшить шрифт" />

            <ImageButton
                android:id="@+id/btnIncreaseText"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_text_increase"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Увеличить шрифт" />

        </LinearLayout>

        <!-- Нижняя декоративная линия -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/reading_divider"
            android:layout_marginBottom="16dp" />

        <!-- Кнопка закрытия -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Закрыть"
            android:textSize="16sp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            app:cornerRadius="24dp"
            app:backgroundTint="@color/primary"
            android:textColor="@color/white" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>